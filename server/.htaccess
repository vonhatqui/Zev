<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Chuyển hướng trang chủ / sang /admin/
    RewriteRule ^$ admin/ [R=302,L]

    # Điều hướng toàn bộ request /api/... sang public/index.php
    RewriteRule ^api/(.*)$ public/index.php [QSA,L]

    # Bảo vệ các thư mục bảo mật không cho client tải trực tiếp
    RewriteRule ^config/ - [F,L]
    RewriteRule ^src/ - [F,L]
    RewriteRule ^database/ - [F,L]
</IfModule>

# Bảo vệ các file đuôi nhạy cảm
<FilesMatch "\.(env|log|sql|sqlite|json|lock|md|sh|bash)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Cấu hình bảo mật HTTP Headers nếu module có sẵn
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>
